FROM ubuntu:24.04

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y build-essential file wget libncurses5-dev unzip bc curl python3 rsync ccache vim less cpio texinfo locales git

RUN locale-gen en_US.UTF-8
ENV LANG en_US.UTF-8

ENV DAPPER_SOURCE /source
ENV DAPPER_OUTPUT ./dist
ENV SHELL /bin/bash
ENV ARTIFACTS /usr/src
WORKDIR ${DAPPER_SOURCE}

# Buildroot used for amd64 and arm64
ENV BUILDROOT_VERSION 2025.02.18
# Buildroot used for riscv64 and loong64: 2025.02 has no LoongArch support
ENV BUILDROOT_VERSION_NEW_ARCHS 2026.02.3
RUN cd ${ARTIFACTS} && \
    wget https://github.com/buildroot/buildroot/archive/${BUILDROOT_VERSION}.tar.gz && \
    wget https://github.com/buildroot/buildroot/archive/${BUILDROOT_VERSION_NEW_ARCHS}.tar.gz

ARG DAPPER_HOST_ARCH=amd64
ARG HOST_ARCH=${DAPPER_HOST_ARCH}
ARG ARCH=${HOST_ARCH}
ARG RELEASE_VERSION
ENV RELEASE_VERSION=${RELEASE_VERSION}
ENV ARCH=${ARCH}
ENV HOST_ARCH=${HOST_ARCH}
ENV FORCE_UNSAFE_CONFIGURE=1

ENTRYPOINT ["./scripts/entry"]
CMD ["ci"]
