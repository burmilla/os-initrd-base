#!/bin/bash
set -e

cd $(dirname $0)/..

: ${CONFIG:=$(pwd)/config}
: ${DIST:=$(pwd)/dist}
: ${ARCH:='amd64 arm64 mips64el'}

echo "about to update config ${ARCH}"

mkdir -p ${DIST}/artifacts

for arch in $ARCH; do
  case ${arch} in
    riscv64|loong64) export TARBALL=${BUILDROOT_VERSION_NEW_ARCHS}.tar.gz ;;
    *) export TARBALL=${BUILDROOT_VERSION}.tar.gz ;;
  esac
  ./scripts/build-busybox "config" ${CONFIG}/${arch}/buildroot-config-static ${CONFIG}/busybox-dynamic.config
done
